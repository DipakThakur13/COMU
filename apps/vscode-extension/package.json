{
  "name": "comu-ai",
  "displayName": "COMU AI Coding Agent",
  "description": "Multi-Model AI Coding Agent for VS Code",
  "version": "0.1.3",
  "publisher": "DipakKumarBoswasGroup",
  "icon": "resources/icon.png",
  "author": {
    "name": "Dipak Kumar (Boswas Group)",
    "url": "https://www.boswas.co.in"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/DipakThakur13/COMU.git",
    "directory": "apps/vscode-extension"
  },
  "homepage": "https://github.com/DipakThakur13/COMU#readme",
  "bugs": {
    "url": "https://github.com/DipakThakur13/COMU/issues"
  },
  "keywords": [
    "ai",
    "coding-agent",
    "nemotron",
    "nvidia",
    "byok",
    "autonomous",
    "developer-tools"
  ],
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "AI",
    "Programming Languages",
    "Machine Learning",
    "Other"
  ],
  "activationEvents": [
    "onView:comu.chatView"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "comu.openChat",
        "title": "COMU: Open Chat"
      },
      {
        "command": "comu.openProviderSettings",
        "title": "COMU: Open Provider Settings"
      },
      {
        "command": "comu.configureNvidia",
        "title": "COMU: Configure NVIDIA Provider"
      },
      {
        "command": "comu.testProviderConnection",
        "title": "COMU: Test NVIDIA Connection"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "comu-sidebar",
          "title": "COMU AI",
          "icon": "$(hubot)"
        }
      ]
    },
    "views": {
      "comu-sidebar": [
        {
          "type": "webview",
          "id": "comu.chatView",
          "name": "Chat"
        }
      ]
    },
    "configuration": {
      "title": "COMU AI",
      "properties": {
        "comu.runtime.baseUrl": {
          "type": "string",
          "default": "http://localhost:3456",
          "description": "Base URL of the COMU Agent Runtime"
        },
        "comu.defaultModel": {
          "type": "string",
          "default": "nvidia-nemotron-3-ultra",
          "description": "Default model ID to use"
        }
      }
    }
  },
  "scripts": {
    "copy-server": "node -e \"const fs = require('fs'); fs.mkdirSync('server', { recursive: true }); fs.copyFileSync('../agent-runtime/dist/server.js', 'server/index.js');\"",
    "build": "pnpm run copy-server && pnpm run compile",
    "vscode:prepublish": "pnpm --filter @comu/agent-runtime build && pnpm run copy-server && pnpm run compile",
    "compile": "tsup",
    "watch": "tsup --watch",
    "test-compile": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "test": "pnpm run test-compile && node ./dist/test/runTest.js"
  },
  "dependencies": {
    "@comu/protocol": "workspace:*",
    "@comu/provider-nvidia": "workspace:*",
    "eventsource-parser": "^4.1.0"
  },
  "devDependencies": {
    "@types/glob": "^9.0.0",
    "@types/mocha": "^10.0.10",
    "@types/vscode": "^1.85.0",
    "@vscode/test-electron": "^3.1.0",
    "glob": "^13.0.6",
    "mocha": "^12.0.0"
  }
}
