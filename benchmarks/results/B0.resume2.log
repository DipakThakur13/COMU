    content: '"""Field-level checks for the order payloads the storefront posts to us."""\n' +
      '\n' +
      'from dataclasses import dataclass\n' +
      '\n' +
      '\n' +
      '@dataclass(frozen=True)\n' +
      'class FieldError:\n' +
      '    """One thing wrong with one field.\n' +
      '\n' +
      '    ``field`` is the dotted path to it, ``code`` says whether it was absent or unusable, and\n' +
      '    ``message`` is for whoever reads the rejection.\n' +
      '    """\n' +
      '\n' +
      '    field: str\n' +
      '    code: str\n' +
      '    message: str\n' +
      '\n' +
      '\n' +
      'def is_text(value: object) -> bool:\n' +
      '    """True for a string with something other than whitespace in it."""\n' +
      '    return isinstance(value, str) and value.strip() != ""\n' +
      '\n' +
      '\n' +
      'def is_currency_code(value: object) -> bool:\n' +
      '    """True for exactly three uppercase ASCII letters, the way ISO 4217 writes them."""\n' +
      '    return (\n' +
      '        isinstance(value, str)\n' +
      '        and len(value) == 3\n' +
      '        and value.isascii()\n' +
      '        and value.isalpha()\n' +
      '        and value.isupper()\n' +
      '    )\n' +
      '\n' +
      '\n' +
      'def is_count(value: object) -> bool:\n' +
      '    """True for a whole number of at least one. A bool is not a count, however much it is an int."""\n' +
      '    return isinstance(value, int) and not isinstance(value, bool) and value >= 1\n' +
      '\n' +
      '\n' +
      'def is_money(value: object) -> bool:\n' +
      '    """True for a non-negative amount. A bool is not an amount; neither is a NaN."""\n' +
      '    if isinstance(value, bool):\n' +
      '        return False\n' +
      '    return isinstance(value, (int, float)) and value >= 0\n',
