  result: {
    content: '/** A small JSON client for the catalog service. */\n' +
      '\n' +
      'export interface HttpResponse {\n' +
      '  status: number;\n' +
      '  body: string;\n' +
      '}\n' +
      '\n' +
      '/** Whatever actually performs the request. Injected so the tests need no network. */\n' +
      'export type Transport = (path: string) => Promise<HttpResponse>;\n' +
      '\n' +
      '/** A response the server did send, but with a status the caller cannot use. */\n' +
      'export class HttpError extends Error {\n' +
      '  readonly status: number;\n' +
      '\n' +
      '  constructor(status: number, path: string) {\n' +
      '    super(`GET ${path} failed with ${status}`);\n' +
      '    this.name = "HttpError";\n' +
      '    this.status = status;\n' +
      '  }\n' +
      '}\n' +
      '\n' +
      'export class ApiClient {\n' +
      '  #transport: Transport;\n' +
      '\n' +
      '  constructor(transport: Transport) {\n' +
      '    this.#transport = transport;\n' +
      '  }\n' +
      '\n' +
      '  /** GETs `path` and parses the body as JSON. */\n' +
      '  async getJson<T>(path: string): Promise<T> {\n' +
      '    const response = await this.#transport(path);\n' +
      '    if (response.status >= 400) throw new HttpError(response.status, path);\n' +
      '    return JSON.parse(response.body) as T;\n' +
      '  }\n' +
      '}\n',
    hash: '415d88346b01e0fbfa6b024c690716780d735a7a364eccda32e30d5fd6287e63',
