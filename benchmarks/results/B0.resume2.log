[Event tool.completed] {
  type: 'tool.completed',
  tool: 'read_file',
  target: 'src/store.ts',
  toolCallId: 'call-71913112-2165-4ee8-974d-5522e868f54b',
  result: {
    content: '/**\n' +
      ' * An in-memory users-and-orders store.\n' +
      ' *\n' +
      " * Everything handed out is a copy: callers hold values, never the store's own records.\n" +
      ' */\n' +
      '\n' +
      'export type OrderStatus = "pending" | "shipped" | "cancelled";\n' +
      '\n' +
      'export interface User {\n' +
      '  id: string;\n' +
      '  name: string;\n' +
      '}\n' +
      '\n' +
      'export interface Order {\n' +
      '  id: string;\n' +
      '  userId: string;\n' +
      '  status: OrderStatus;\n' +
      '  /** Whole currency units. */\n' +
      '  total: number;\n' +
      '  /** An ISO-8601 calendar date, YYYY-MM-DD. */\n' +
      '  placedAt: string;\n' +
      '}\n' +
      '\n' +
      'const users = new Map<string, User>();\n' +
      'const orders = new Map<string, Order>();\n' +
      '\n' +
      '/** Empties the store. */\n' +
      'export function reset(): void {\n' +
      '  users.clear();\n' +
      '  orders.clear();\n' +
      '}\n' +
      '\n' +
      'export function addUser(user: User): User {\n' +
      '  if (users.has(user.id)) throw new Error(`duplicate user: ${user.id}`);\n' +
      '  users.set(user.id, { ...user });\n' +
      '  return { ...user };\n' +
      '}\n' +
      '\n' +
      'export function getUser(id: string): User | undefined {\n' +
      '  const found = users.get(id);\n' +
      '  return found ? { ...found } : undefined;\n' +
      '}\n' +
      '\n' +
      'export function addOrder(order: Order): Order {\n' +
      '  if (!users.has(order.userId)) throw new Error(`unknown user: ${order.userId}`);\n' +
      '  if (orders.has(order.id)) throw new Error(`duplicate order: ${order.id}`);\n' +
      '  orders.set(order.id, { ...order });\n' +
      '  return { ...order };\n' +
      '}\n' +
      '\n' +
      '/** Every order in the store, newest first. */\n' +
      'export function listOrders(): Order[] {\n' +
      '  return [...orders.values()].sort(byNewestFirst).map(order => ({ ...order }));\n' +
      '}\n' +
      '\n' +
      '/** Newest first by placement date; ties broken by ascending id so the order is total. */\n' +
      'function byNewestFirst(a: Order, b: Order): number {\n' +
      '  if (a.placedAt !== b.placedAt) return a.placedAt < b.placedAt ? 1 : -1;\n' +
      '  return a.id < b.id ? -1 : 1;\n' +
      '}\n',
    hash: '67a9012ca68f05481e98740f33a2cf5007f8f8d5e2b9ee58dec8532ba12e1ffd',
