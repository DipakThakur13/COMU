      '    assert not is_text(None)\n' +
      '    assert not is_text(7)\n' +
      '\n' +
      '\n' +
      'def test_is_currency_code_accepts_three_uppercase_letters():\n' +
      '    assert is_currency_code("EUR")\n' +
      '    assert is_currency_code("GBP")\n' +
      '\n' +
      '\n' +
      'def test_is_currency_code_rejects_anything_else():\n' +
      '    assert not is_currency_code("eur")\n' +
      '    assert not is_currency_code("EURO")\n' +
      '    assert not is_currency_code("E1R")\n' +
      '    assert not is_currency_code(978)\n' +
      '\n' +
      '\n' +
      'def test_is_count_requires_a_whole_number_of_at_least_one():\n' +
