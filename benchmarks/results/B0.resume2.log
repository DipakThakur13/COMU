    content: 'import { loadSettings } from "./config/settings.ts";\n' +
      'import { profileByName } from "./config/profiles.ts";\n' +
      'import { buildPipeline } from "./pipeline/build.ts";\n' +
      'import { runPipeline } from "./pipeline/runner.ts";\n' +
      'import { createSource } from "./sources/sourceFactory.ts";\n' +
      'import { createLogger } from "./util/logger.ts";\n' +
      'import { SystemClock } from "./util/clock.ts";\n' +
      '\n' +
      '/**\n' +
      ' * Entry point. Reads the profile named on the command line, assembles the stages and runs them\n' +
      ' * until the source is exhausted or the process is asked to stop.\n' +
      ' */\n' +
      'async function main(): Promise<void> {\n' +
      '  const argv = process.argv.slice(2);\n' +
      '  const profileName = argv[argv.indexOf("--profile") + 1] ?? "default";\n' +
      '  const profile = profileByName(profileName);\n' +
      '  const settings = loadSettings(process.env, profile);\n' +
      '\n' +
      '  const logger = createLogger(profile.name);\n' +
      '  const clock = new SystemClock();\n' +
      '\n' +
      '  const source = createSource(settings, logger);\n' +
      '  const pipeline = buildPipeline(settings, clock, logger);\n' +
      '\n' +
      '  const stop = () => void source.close();\n' +
      '  process.on("SIGINT", stop);\n' +
      '  process.on("SIGTERM", stop);\n' +
      '\n' +
      '  const summary = await runPipeline(source, pipeline, settings, logger);\n' +
      '  logger.info("finished", summary);\n' +
      '}\n' +
      '\n' +
      'void main();\n',
