  target: 'src/pipeline/runner.ts',
  toolCallId: 'call-db6c962a-e9c1-41aa-a79b-ecc86cc946c6',
  result: {
    content: 'import type { Settings } from "../config/settings.ts";\n' +
      'import type { Logger } from "../util/logger.ts";\n' +
      'import type { Source } from "../sources/sourceFactory.ts";\n' +
      'import type { Stage } from "./stage.ts";\n' +
      'import { makeContext } from "./stage.ts";\n' +
      'import { decoderFor } from "../decode/decoderRegistry.ts";\n' +
      'import { RingBuffer } from "../buffer/ringBuffer.ts";\n' +
      'import { shouldPause } from "../buffer/backpressure.ts";\n' +
      '\n' +
      'export interface Summary {\n' +
      '  read: number;\n' +
      '  dropped: number;\n' +
      '  quarantined: number;\n' +
      '  counters: Record<string, number>;\n' +
      '}\n' +
      '\n' +
      '/**\n' +
      ' * Reads chunks from the source, decodes them, parks the records in the ring buffer and pushes\n' +
      ' * them through the stages.\n' +
      ' *\n' +
      ' * The backpressure check is here, and it is advisory only: `shouldPause` is consulted, the answer\n' +
      ' * is written to the log, and the loop carries on regardless. Nothing in this repository ever waits\n' +
      ' * for the buffer to drain.\n' +
      ' */\n' +
      'export async function runPipeline(\n' +
      '  source: Source,\n' +
      '  stages: Stage[],\n' +
      '  settings: Settings,\n' +
      '  logger: Logger\n' +
      '): Promise<Summary> {\n' +
      '  const context = makeContext(settings.profile.name);\n' +
      '  const buffer = new RingBuffer(settings.bufferSlots);\n' +
      '  let read = 0;\n' +
      '\n' +
      '  for await (const chunk of source.chunks()) {\n' +
      '    const decoder = decoderFor(chunk.bytes, chunk.name);\n' +
      '    for (const record of decoder.decode(chunk.bytes)) {\n' +
      '      read += 1;\n' +
      '      buffer.push(record);\n' +
      '      if (shouldPause(buffer)) {\n' +
      '        logger.warn("backpressure_advised", { filled: buffer.size(), slots: buffer.capacity() });\n' +
      '      }\n' +
      '    }\n' +
      '\n' +
      '    for (const record of buffer.drain()) {\n' +
      '      let carried: Record<string, unknown> | undefined = record;\n' +
      '      for (const stage of stages) {\n' +
      '        if (!carried) break;\n' +
      '        carried = await stage.apply(carried, context);\n' +
      '        if (!carried) context.bump("dropped." + stage.name);\n' +
      '      }\n' +
      '    }\n' +
      '\n' +
      '    if (context.quarantine.length > settings.quarantineLimit) {\n' +
      '      throw new Error("quarantine limit exceeded: " + context.quarantine.length);\n' +
      '    }\n' +
      '  }\n' +
      '\n' +
      '  return {\n' +
      '    read,\n' +
      '    dropped: buffer.droppedCount(),\n' +
      '    quarantined: context.quarantine.length,\n' +
      '    counters: Object.fromEntries(context.counters)\n' +
      '  };\n' +
      '}\n',
