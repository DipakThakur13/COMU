    content: 'import type { Settings } from "../config/settings.ts";\n' +
      'import type { Clock } from "../util/clock.ts";\n' +
      'import type { Logger } from "../util/logger.ts";\n' +
      'import type { Stage } from "./stage.ts";\n' +
      'import { fieldMapStage } from "../normalise/fieldMap.ts";\n' +
      'import { currencyStage } from "../normalise/currency.ts";\n' +
      'import { timestampStage } from "../normalise/timestamps.ts";\n' +
      'import { instrumentStage } from "../enrich/instrumentLookup.ts";\n' +
      'import { sectorStage } from "../enrich/sectorTagger.ts";\n' +
      'import { selectSink, sinkStage } from "../sink/sinkSelector.ts";\n' +
      '\n' +
      '/**\n' +
      ' * Assembles the stage list. The order here is the whole contract of the pipeline.\n' +
      ' *\n' +
      ' * Note where the sink stage sits: last, after both enrichment stages. Validation lives inside the\n' +
      ' * sink stage, so a record that will be quarantined has already paid for an instrument lookup and\n' +
      ' * a sector tag by the time anyone checks whether it is a quote at all.\n' +
      ' */\n' +
      'export function buildPipeline(settings: Settings, clock: Clock, logger: Logger): Stage[] {\n' +
      '  const sink = selectSink(settings, clock, logger);\n' +
      '\n' +
      '  return [\n' +
      '    fieldMapStage(settings.profile),\n' +
      '    currencyStage(settings.profile),\n' +
      '    timestampStage(settings.profile),\n' +
      '    instrumentStage(),\n' +
      '    sectorStage(),\n' +
      '    sinkStage(sink, settings, logger)\n' +
      '  ];\n' +
      '}\n',
