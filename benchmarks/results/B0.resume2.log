      '\n' +
      'function seed(): void {\n' +
      '  reset();\n' +
      '  addUser({ id: "u1", name: "Ada" });\n' +
      '  addUser({ id: "u2", name: "Blaise" });\n' +
      '  addOrder({ id: "o1", userId: "u1", status: "pending", total: 120, placedAt: "2026-01-05" });\n' +
      '  addOrder({ id: "o2", userId: "u1", status: "shipped", total: 40, placedAt: "2026-02-10" });\n' +
      '  addOrder({ id: "o3", userId: "u2", status: "pending", total: 300, placedAt: "2026-02-10" });\n' +
      '  addOrder({ id: "o4", userId: "u1", status: "cancelled", total: 75, placedAt: "2026-03-01" });\n' +
      '  addOrder({ id: "o5", userId: "u1", status: "shipped", total: 500, placedAt: "2026-02-10" });\n' +
      '}\n' +
      '\n' +
      'test("a user can be read back after being added", () => {\n' +
      '  seed();\n' +
      '  assert.deepEqual(getUser("u1"), { id: "u1", name: "Ada" });\n' +
      '});\n' +
      '\n' +
      'test("an unknown user reads back as undefined", () => {\n' +
      '  seed();\n' +
      '  assert.equal(getUser("nobody"), undefined);\n' +
      '});\n' +
      '\n' +
      'test("an order for an unknown user is rejected", () => {\n' +
      '  seed();\n' +
