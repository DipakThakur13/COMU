    content: 'import test from "node:test";\n' +
      'import assert from "node:assert/strict";\n' +
      'import { setTimeout as delay } from "node:timers/promises";\n' +
      'import { loadRows, summarize, type Row } from "./catalogue.ts";\n' +
      '\n' +
      'const LATENCY: Record<string, number> = { a: 30, b: 20, c: 10 };\n' +
      '\n' +
      'async function load(id: string): Promise<Row> {\n' +
      '  await delay(LATENCY[id] ?? 0);\n' +
      '  return { id, label: id.toUpperCase() };\n' +
      '}\n' +
      '\n' +
      'test("rows come back in the order they were asked for", async () => {\n' +
      '  const rows = await loadRows(["a", "b", "c"], load);\n' +
      '  assert.deepEqual(\n' +
      '    rows.map(row => row.id),\n' +
      '    ["a", "b", "c"]\n' +
      '  );\n' +
      '});\n' +
      '\n' +
      'test("the summary lists the labels in the order they were asked for", async () => {\n' +
      '  assert.equal(await summarize(["a", "b", "c"], load), "A, B, C");\n' +
      '});\n' +
      '\n' +
      'test("loading nothing summarises to nothing", async () => {\n' +
      '  assert.equal(await summarize([], load), "");\n' +
      '});\n',
