    content: 'import test from "node:test";\n' +
      'import assert from "node:assert/strict";\n' +
      'import { setTimeout as delay } from "node:timers/promises";\n' +
      'import { mapConcurrent } from "./concurrency.ts";\n' +
      '\n' +
      'test("a result comes back for every item, in the order the items were given", async () => {\n' +
      '  const items = [1, 2, 3, 4];\n' +
      '  const doubled = await mapConcurrent(items, 4, async item => {\n' +
      '    await delay((5 - item) * 20);\n' +
      '    return item * 2;\n' +
      '  });\n' +
      '  assert.deepEqual(doubled, [2, 4, 6, 8]);\n' +
      '});\n' +
      '\n' +
      'test("no more than the limit run at once", async () => {\n' +
      '  let running = 0;\n' +
      '  let peak = 0;\n' +
      '  await mapConcurrent([1, 2, 3, 4, 5, 6], 2, async item => {\n' +
      '    running += 1;\n' +
      '    peak = Math.max(peak, running);\n' +
      '    await delay(5);\n' +
      '    running -= 1;\n' +
      '    return item;\n' +
      '  });\n' +
      '  assert.equal(peak, 2);\n' +
      '});\n' +
      '\n' +
      'test("an empty list of items produces no results", async () => {\n' +
      '  const results = await mapConcurrent<number, number>([], 3, async item => item);\n' +
      '  assert.deepEqual(results, []);\n' +
      '});\n',
