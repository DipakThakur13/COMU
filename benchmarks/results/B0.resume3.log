  result: {
    content: 'import { mapConcurrent } from "./concurrency.ts";\n' +
      '\n' +
      'export interface Row {\n' +
      '  id: string;\n' +
      '  label: string;\n' +
      '}\n' +
      '\n' +
      '/** How many catalogue reads the service is allowed to have open at once. */\n' +
      'export const READ_LIMIT = 3;\n' +
      '\n' +
      '/** Loads one row per id, in the order the ids were given. */\n' +
      'export async function loadRows(\n' +
      '  ids: readonly string[],\n' +
      '  load: (id: string) => Promise<Row>\n' +
      '): Promise<Row[]> {\n' +
      '  return mapConcurrent(ids, READ_LIMIT, id => load(id));\n' +
      '}\n' +
      '\n' +
      '/** A one line summary of the rows, in the order they were requested. */\n' +
      'export async function summarize(\n' +
      '  ids: readonly string[],\n' +
      '  load: (id: string) => Promise<Row>\n' +
      '): Promise<string> {\n' +
      '  const rows = await loadRows(ids, load);\n' +
      '  return rows.map(row => row.label).join(", ");\n' +
      '}\n',
    hash: 'fa09c0e3e12e4a7e6deec124d6a3f1db24172d9241b743da5df0fa881fadaf24',
