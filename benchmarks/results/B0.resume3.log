[Event tool.completed] {
  type: 'tool.completed',
  tool: 'read_file',
  target: 'src/permits/adapters/audited_repository.py',
  toolCallId: 'call-8a21d9d5-69d2-448d-8e61-9b3fc4361023',
  result: {
    content: 'from __future__ import annotations\n' +
      '\n' +
      'import logging\n' +
      '\n' +
      'from permits.audit.trail import AuditTrail\n' +
      'from permits.domain.application import Application\n' +
      'from permits.domain.rules import assert_caller_may_write\n' +
      'from permits.ports.repository import Repository\n' +
      '\n' +
      '\n' +
      'class AuditedRepository:\n' +
      '    """A decorator around whichever repository the factory picked.\n' +
      '\n' +
      '    It does two jobs that most readers would look for somewhere else entirely.\n' +
      '\n' +
      '    First, authorisation: every ``save`` calls\n' +
      '    :func:`permits.domain.rules.assert_caller_may_write` before delegating, which makes this class\n' +
      '    the access control point of the whole service. Nothing in ``transport`` checks the actor.\n' +
      '\n' +
      '    Second, the audit trail: every accepted save is appended to :class:`permits.audit.trail.\n' +
      '    AuditTrail`. No service writes to the trail, so a code path that bypasses the repository\n' +
      '    leaves no record at all.\n' +
      '    """\n' +
      '\n' +
      '    def __init__(self, inner: Repository, trail: AuditTrail, logger: logging.Logger) -> None:\n' +
      '        self._inner = inner\n' +
      '        self._trail = trail\n' +
      '        self._logger = logger\n' +
      '        self.kind = f"audited({inner.kind})"\n' +
      '\n' +
      '    def save(self, application: Application, actor: str) -> None:\n' +
      '        assert_caller_may_write(actor, application)\n' +
      '        self._inner.save(application, actor)\n' +
      '        self._trail.append(actor, application.reference, application.state)\n' +
      '        self._logger.info("saved reference=%s state=%s actor=%s", application.reference, application.state, actor)\n' +
      '\n' +
      '    def get(self, reference: str) -> Application | None:\n' +
      '        return self._inner.get(reference)\n' +
      '\n' +
      '    def next_sequence(self) -> int:\n' +
      '        return self._inner.next_sequence()\n' +
      '\n' +
      '    def all_references(self) -> list[str]:\n' +
      '        return self._inner.all_references()\n' +
      '\n' +
      '    def trail_size(self) -> int:\n' +
      '        return self._trail.size()\n',
    hash: '4025096bbb23f068258ea76a17a170fce695bfd0b465bd9abc1e6ccdd9554b2b',
