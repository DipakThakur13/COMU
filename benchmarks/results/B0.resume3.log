      'import logging\n' +
      'from typing import Any\n' +
      '\n' +
      'from permits.domain.application import Application, SUBMITTED, reference_for\n' +
      'from permits.domain.rules import build_or_raise\n' +
      'from permits.domain.state_machine import transition\n' +
      'from permits.ports.clock import Clock\n' +
      'from permits.ports.repository import Repository\n' +
      '\n' +
      '\n' +
      'class IntakeService:\n' +
      '    """Turns a payload into a stored, submitted application.\n' +
      '\n' +
      '    Field validation happens here, through :func:`permits.domain.rules.build_or_raise`, so a\n' +
      '    malformed body is refused synchronously with a 422. Authorisation does not happen here; the\n' +
      '    actor is carried along and checked much later, inside the repository decorator.\n' +
      '    """\n' +
      '\n' +
      '    def __init__(self, repository: Repository, clock: Clock, logger: logging.Logger) -> None:\n' +
      '        self._repository = repository\n' +
      '        self._clock = clock\n' +
      '        self._logger = logger\n' +
      '\n' +
      '    def submit(self, payload: dict[str, Any], actor: str) -> Application:\n' +
      '        at = self._clock.now_iso()\n' +
      '        reference = reference_for(self._repository.next_sequence(), at)\n' +
      '\n' +
      '        application = build_or_raise(payload, reference, at)\n' +
      '        submitted = transition(application, SUBMITTED, at)\n' +
      '\n' +
      '        self._repository.save(submitted, actor)\n' +
      '        self._logger.info("submitted reference=%s", reference)\n' +
      '        return submitted\n' +
      '\n' +
      '    def fetch(self, reference: str) -> Application | None:\n' +
      '        return self._repository.get(reference)\n',
