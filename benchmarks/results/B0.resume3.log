      '    """Field level checks, used when an application is first built."""\n' +
      '    problems: list[str] = []\n' +
      '\n' +
      '    applicant = str(payload.get("applicant", "")).strip()\n' +
      '    if len(applicant) < 3:\n' +
      '        problems.append("applicant is too short")\n' +
      '\n' +
      '    address = str(payload.get("address", "")).strip()\n' +
      '    if len(address) < 6:\n' +
      '        problems.append("address is too short")\n' +
      '\n' +
      '    work_kind = str(payload.get("workKind", ""))\n' +
      '    if work_kind not in WORK_KINDS:\n' +
      '        problems.append("workKind is not a known kind")\n' +
      '\n' +
      '    try:\n' +
      '        cost = int(payload.get("estimatedCostPence", -1))\n' +
      '    except (TypeError, ValueError):\n' +
      '        cost = -1\n' +
      '    if cost < 0 or cost > MAX_COST_PENCE:\n' +
      '        problems.append("estimatedCostPence is out of range")\n' +
      '\n' +
      '    return problems\n' +
      '\n' +
      '\n' +
      'def build_or_raise(payload: dict[str, Any], reference: str, at: str) -> Application:\n' +
      '    problems = check_payload(payload)\n' +
      '    if problems:\n' +
      '        raise InvalidApplication("; ".join(problems))\n' +
      '    return Application(\n' +
      '        reference=reference,\n' +
      '        applicant=str(payload["applicant"]).strip(),\n' +
      '        address=str(payload["address"]).strip(),\n' +
      '        work_kind=str(payload["workKind"]),\n' +
      '        estimated_cost_pence=int(payload["estimatedCostPence"]),\n' +
      '        state="draft",\n' +
      '        submitted_at=at,\n' +
      '    )\n' +
      '\n' +
      '\n' +
      'def assert_caller_may_write(actor: str, application: Application) -> None:\n' +
      '    """Authorisation.\n' +
      '\n' +
      '    This is the only access control in the service, and nothing in the transport layer calls it.\n' +
      '    Its single caller is the persistence decorator, so a request is authorised at the moment it\n' +
      '    would be written and not a step earlier: an unauthorised caller still runs the whole service\n' +
      '    method and only fails when the repository is asked to save.\n' +
      '\n' +
      '    An applicant may write their own application. Anyone whose actor id starts with the\n' +
      '    caseworker prefix may write any of them. An empty actor may write nothing.\n' +
      '    """\n' +
      '    if actor.startswith(CASEWORKER_PREFIX):\n' +
      '        return\n' +
      '    if actor and actor == application.applicant:\n' +
      '        return\n' +
      `    raise NotPermitted(f"{actor or 'anonymous'} may not write {application.reference}")\n`,
