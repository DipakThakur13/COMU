  result: {
    content: '/** A worker pool with a fixed width. */\n' +
      '\n' +
      '/**\n' +
      ' * Runs `worker` over every item, at most `limit` at a time, and returns one result per item in the\n' +
      ' * order the items were given.\n' +
      ' */\n' +
      'export async function mapConcurrent<T, R>(\n' +
      '  items: readonly T[],\n' +
      '  limit: number,\n' +
      '  worker: (item: T, index: number) => Promise<R>\n' +
      '): Promise<R[]> {\n' +
      '  const results: R[] = [];\n' +
      '  const lanes = Math.max(1, Math.min(limit, items.length));\n' +
      '  let next = 0;\n' +
      '\n' +
      '  async function runLane(): Promise<void> {\n' +
      '    while (next < items.length) {\n' +
      '      const index = next;\n' +
      '      next += 1;\n' +
      '      const value = await worker(items[index] as T, index);\n' +
      '      results.push(value);\n' +
      '    }\n' +
      '  }\n' +
      '\n' +
      '  await Promise.all(Array.from({ length: lanes }, () => runLane()));\n' +
      '  return results;\n' +
      '}\n',
