    content: 'from __future__ import annotations\n' +
      '\n' +
      'import logging\n' +
      '\n' +
      'from permits.adapters.audited_repository import AuditedRepository\n' +
      'from permits.adapters.memory_repository import MemoryRepository\n' +
      'from permits.adapters.sqlite_repository import SqliteRepository\n' +
      'from permits.audit.trail import AuditTrail\n' +
      'from permits.ports.clock import Clock\n' +
      'from permits.ports.repository import Repository\n' +
      'from permits.settings import Settings\n' +
      '\n' +
      '\n' +
      'def build_repository(settings: Settings, clock: Clock, logger: logging.Logger) -> Repository:\n' +
      '    """Pick the store, then hide the choice.\n' +
      '\n' +
      '    An empty ``PERMITS_DSN`` means MemoryRepository and a set one means SqliteRepository, which is\n' +
      '    the obvious half. The half that matters is the last line: whichever store is chosen is always\n' +
      '    wrapped in AuditedRepository, so no caller anywhere ever holds a bare repository, and the\n' +
      '    authorisation and audit behaviour cannot be switched off by configuration.\n' +
      '    """\n' +
      '    inner: Repository = SqliteRepository(settings.dsn) if settings.dsn else MemoryRepository()\n' +
      '    logger.info("repository_selected kind=%s", inner.kind)\n' +
      '    return AuditedRepository(inner, AuditTrail(clock), logger)\n',
    hash: 'e4913b8d74508d87c7a531e52e8ed23cb6a140f9cd1e32e2f4aef18bdf500141',
