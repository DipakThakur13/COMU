      'from permits.services.notify_service import NotifyService\n' +
      'from permits.services.review_service import ReviewService\n' +
      'from permits.settings import Settings\n' +
      '\n' +
      '_current: "App | None" = None\n' +
      '\n' +
      '\n' +
      '@dataclass\n' +
      'class App:\n' +
      '    settings: Settings\n' +
      '    clock: Clock\n' +
      '    logger: logging.Logger\n' +
      '    repository: Repository\n' +
      '    cache: DecisionCache\n' +
      '    spool: Spool\n' +
      '    notifier: Notifier\n' +
      '    worker: SpoolWorker\n' +
      '    intake: IntakeService\n' +
      '    review: ReviewService\n' +
      '    notify: NotifyService\n' +
      '\n' +
      '\n' +
      'def build_app(settings: Settings) -> App:\n' +
      '    """The composition root.\n' +
      '\n' +
      '    The only function in the package where a concrete class is given to a port. Handlers are not\n' +
      '    passed anything: they are imported on demand by the dispatcher and call :func:`app` instead.\n' +
      '    """\n' +
      '    global _current\n' +
      '\n' +
      '    logging.basicConfig(level=logging.INFO, format="%(levelname)s %(name)s %(message)s")\n' +
      '    logger = logging.getLogger("permits")\n' +
      '    clock = SystemClock()\n' +
      '\n' +
      '    repository = build_repository(settings, clock, logger)\n' +
      '    cache = DecisionCache(clock, settings.decision_ttl_s)\n' +
      '    spool = Spool(clock)\n' +
      '\n' +
      '    notifier: Notifier = SpoolNotifier(spool) if settings.notifier == "spool" else StdoutNotifier()\n' +
      '    worker = SpoolWorker(spool, notifier, clock, logger, settings.spool_interval_s, settings.spool_max_attempts)\n' +
      '\n' +
      '    intake = IntakeService(repository, clock, logger)\n' +
      '    review = ReviewService(repository, cache, clock, logger)\n' +
      '    notify = NotifyService(spool, clock)\n' +
      '\n' +
      '    _current = App(\n' +
      '        settings=settings,\n' +
      '        clock=clock,\n' +
      '        logger=logger,\n' +
      '        repository=repository,\n' +
      '        cache=cache,\n' +
      '        spool=spool,\n' +
      '        notifier=notifier,\n' +
      '        worker=worker,\n' +
      '        intake=intake,\n' +
      '        review=review,\n' +
      '        notify=notify,\n' +
      '    )\n' +
      '    return _current\n' +
      '\n' +
      '\n' +
      'def app() -> App:\n' +
      '    """Handlers reach their dependencies through this, because nothing hands them any."""\n' +
      '    if _current is None:\n' +
      '        raise RuntimeError("app() called before build_app()")\n' +
