  result: {
    content: 'from __future__ import annotations\n' +
      '\n' +
      'import logging\n' +
      'from dataclasses import replace\n' +
      'from typing import Any\n' +
      '\n' +
      'from permits.cache.decision_cache import DecisionCache\n' +
      'from permits.domain.application import (\n' +
      '    Application,\n' +
      '    GRANTED,\n' +
      '    IN_REVIEW,\n' +
      '    REFUSED,\n' +
      '    WITHDRAWN,\n' +
      ')\n' +
      'from permits.domain.errors import IllegalTransition, UnknownApplication\n' +
      'from permits.domain.state_machine import transition\n' +
      'from permits.ports.clock import Clock\n' +
      'from permits.ports.repository import Repository\n' +
      '\n' +
      '_OUTCOMES = {"granted": GRANTED, "refused": REFUSED}\n' +
      '\n' +
      '\n' +
      'def render_decision_letter(reference: str, applicant: str) -> str:\n' +
      '    """The letter body.\n' +
      '\n' +
      '    It lives in the service layer and is imported downward by\n' +
      '    :mod:`permits.adapters.spool_notifier`, which is the wrong direction and has been noted as\n' +
      '    such in three separate design reviews.\n' +
      '    """\n' +
      '    return (\n' +
      '        f"Dear {applicant},\\n\\n"\n' +
      '        f"The council has reached a decision on application {reference}. "\n' +
      '        "The formal notice follows by post.\\n\\n"\n' +
      '        "Planning Department\\n"\n' +
      '    )\n' +
      '\n' +
      '\n' +
      'class ReviewService:\n' +
      '    """Moves an application through review and records the decision."""\n' +
      '\n' +
      '    def __init__(\n' +
      '        self,\n' +
      '        repository: Repository,\n' +
      '        cache: DecisionCache,\n' +
      '        clock: Clock,\n' +
      '        logger: logging.Logger,\n' +
      '    ) -> None:\n' +
      '        self._repository = repository\n' +
      '        self._cache = cache\n' +
      '        self._clock = clock\n' +
      '        self._logger = logger\n' +
      '\n' +
      '    def _load(self, reference: str) -> Application:\n' +
      '        found = self._repository.get(reference)\n' +
      '        if found is None:\n' +
      '            raise UnknownApplication(reference)\n' +
      '        return found\n' +
      '\n' +
      '    def record_decision(self, reference: str, outcome: str, note: str, actor: str) -> Application:\n' +
      '        target = _OUTCOMES.get(outcome)\n' +
      '        if target is None:\n' +
      '            raise IllegalTransition(f"{outcome} is not a decision")\n' +
      '\n' +
      '        at = self._clock.now_iso()\n' +
      '        application = self._load(reference)\n' +
      '        if application.state != IN_REVIEW:\n' +
      '            application = transition(application, IN_REVIEW, at)\n' +
      '\n' +
      '        decided = transition(application, target, at)\n' +
      '        decided = replace(decided, decided_at=at, outcome=outcome, note=note)\n' +
      '        self._repository.save(decided, actor)\n' +
      '\n' +
      '        # The cache is refreshed on a grant and only on a grant. A refusal leaves the previous\n' +
      '        # entry in place until it expires, which is the reason the portal can keep showing an old\n' +
      '        # decision for the whole TTL after a refusal or a withdrawal.\n' +
      '        if target == GRANTED:\n' +
      '            self._cache.put(reference, self._as_decision(decided))\n' +
      '\n' +
      '        self._logger.info("decided reference=%s outcome=%s", reference, outcome)\n' +
      '        return decided\n' +
      '\n' +
      '    def withdraw(self, reference: str, actor: str) -> Application:\n' +
      '        at = self._clock.now_iso()\n' +
      '        withdrawn = transition(self._load(reference), WITHDRAWN, at)\n' +
      '        self._repository.save(withdrawn, actor)\n' +
      '        return withdrawn\n' +
      '\n' +
      '    def decision_for(self, reference: str) -> dict[str, Any] | None:\n' +
      '        cached = self._cache.get(reference)\n' +
      '        if cached is not None:\n' +
      '            return cached\n' +
      '\n' +
      '        application = self._repository.get(reference)\n' +
      '        if application is None or application.outcome is None:\n' +
      '            return None\n' +
      '\n' +
      '        decision = self._as_decision(application)\n' +
      '        self._cache.put(reference, decision)\n' +
      '        return decision\n' +
      '\n' +
      '    @staticmethod\n' +
      '    def _as_decision(application: Application) -> dict[str, Any]:\n' +
      '        return {\n' +
      '            "reference": application.reference,\n' +
      '            "outcome": application.outcome,\n' +
      '            "decidedAt": application.decided_at,\n' +
      '            "note": application.note,\n' +
      '            "state": application.state,\n' +
      '        }\n',
