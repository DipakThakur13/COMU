      "@comu/git": [
        "../tools/git/src/index.ts"
      ],
      "@comu/tool-search": [
        "../tools/search/src/index.ts"
      ],
      "@comu/terminal": [
        "../tools/terminal/src/index.ts"
      ],
      "@comu/validation": [
        "../tools/validation/src/index.ts"
      ],
      "@comu/tool-web-docs": [
        "../tools/web-docs/src/index.ts"
      ],
      "@comu/provider-nvidia": [
        "../providers/nvidia/src/index.ts"
      ]
    }
  },
  "include": [
    "src/**/*.ts",
    "tests/**/*.ts"
