        "../packages/agent-core/src/index.ts"
      ],
      "@comu/context-engine": [
        "../packages/context-engine/src/index.ts"
      ],
      "@comu/diagnostics-engine": [
        "../packages/diagnostics-engine/src/index.ts"
      ],
      "@comu/diff-engine": [
        "../packages/diff-engine/src/index.ts"
      ],
      "@comu/memory-engine": [
        "../packages/memory-engine/src/index.ts"
      ],
      "@comu/model-core": [
        "../packages/model-core/src/index.ts"
      ],
      "@comu/planning-engine": [
        "../packages/planning-engine/src/index.ts"
      ],
      "@comu/protocol": [
        "../packages/protocol/src/index.ts"
      ],
      "@comu/repair-engine": [
        "../packages/repair-engine/src/index.ts"
      ],
      "@comu/shared": [
        "../packages/shared/src/index.ts"
      ],
      "@comu/tool-core": [
        "../packages/tool-core/src/index.ts"
      ],
