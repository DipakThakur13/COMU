{
  "name": "@comu/agent-core",
  "version": "0.3.1",
  "private": true,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/"
  },
  "dependencies": {
    "@comu/context-engine": "workspace:*",
    "@comu/diagnostics-engine": "workspace:*",
    "@comu/diff-engine": "workspace:*",
    "@comu/memory-engine": "workspace:*",
    "@comu/model-core": "workspace:*",
    "@comu/planning-engine": "workspace:*",
    "@comu/protocol": "workspace:*",
    "@comu/repair-engine": "workspace:*",
    "@comu/session-store": "workspace:*",
    "@comu/shared": "workspace:*",
    "@comu/tool-core": "workspace:*",
    "@comu/verification-engine": "workspace:*"
  },
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  }
}
